{
    "extends": ["@omni-oss/tsconfig/base.json"],
    "include": ["${configDir}/src/**/*.*", "${configDir}/index.tsx"],
    "compilerOptions": {
        // General
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "target": "ESNext",

        // Modules
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,

        // Type Checking & Safety
        "strict": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "paths": {
          "$*": ["./styled-system/*"],
          "#*": ["./src/*"],
        }
    }
}
