{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": ["./base.json"],
    "compilerOptions": {
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "lib": ["ESNext"],
        "types": ["node"],
        "customConditions": ["development"],
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "exactOptionalPropertyTypes": false,
        "skipLibCheck": true
    }
}
